# OAuth / Auth
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:3000

# Supabase (Postgres) - service role key (server only, never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI
AI_PROVIDER=ollama            # 'ollama' or 'openai'
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP) - password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@omnihabit.app

# Stripe pricing (public)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_TEAM_PRICE_ID=
